pipeline {
    agent { node { label 'jenkins-dev' } }
    options { disableConcurrentBuilds() }
    parameters {
        choice(name: 'NETWORK_PROFILE', choices: ['AML', 'SCD'], description: 'Disease network; builds the matching full validation image profile')
        string(name: 'VALIDATION_PYPI_URL', defaultValue: 'https://pypi.synthema.rid-intrasoft.eu/simple/', description: 'PyPI simple index URL providing safe-validation/sd-metrics; omit credentials from the URL')
        string(name: 'PRIVACY_PYPI_URL', defaultValue: 'https://pypi.synthema.rid-intrasoft.eu/simple/', description: 'PyPI simple index URL providing synth-privacy; omit credentials from the URL')
        string(name: 'SYNTHEMA_PYPI_USERNAME', defaultValue: '', description: 'Shared PyPI username for validation, privacy and fidelity; empty for anonymous access')
        password(name: 'SYNTHEMA_PYPI_PASSWORD', defaultValue: '', description: 'Shared PyPI password; leave both PyPI inputs empty for anonymous access')
        string(name: 'MSI_REPOSITORY', defaultValue: 'https://github.com/synthema-project/app-model_store-interface.git', description: 'MSI source repository')
        string(name: 'MSI_BRANCH', defaultValue: '', description: 'Branch to build, e.g. fl-validation-frozen; build its latest pushed version')
        password(name: 'MSI_GITHUB_TOKEN', defaultValue: '', description: 'GitHub token with read access to the MSI repository; empty for public access')
    }
    environment {
        DOCKER_REG = 'harbor.synthema.rid-intrasoft.eu'
        DOCKER_REPO = '/fl/'
        MSI_WHEELS_PREPARED = '1'
        VALIDATION_PROFILE = "${params.NETWORK_PROFILE.toLowerCase()}-full"
    }
    stages {
        stage('Validate inputs') {
            steps {
                script {
                    sh '''
                        set +x
                        set -eu
                        python3 scripts/package_indexes.py
                        python3 - <<'PYINPUT'
import os
if bool(os.environ.get('SYNTHEMA_PYPI_USERNAME', '').strip()) != bool(os.environ.get('SYNTHEMA_PYPI_PASSWORD', '')):
    raise SystemExit('Supply both PyPI username and password, or leave both empty')
PYINPUT
                    '''
                    env.FL_SOURCE_BRANCH = env.GIT_BRANCH ?: ''
                    def branches = [params.MSI_BRANCH]
                    for (value in branches) {
                        def branch = value.trim()
                        if (!branch) { error('Supply a branch for each selected package') }
                        withEnv(["PACKAGE_BRANCH=${branch}"]) {
                            sh 'git check-ref-format "refs/heads/$PACKAGE_BRANCH"'
                        }
                    }
                    def version = readFile('version').trim()
                    if (!(version ==~ /[A-Za-z0-9_][A-Za-z0-9_.-]*/)) { error('Invalid image version') }
                    env.RELEASE_IMAGE_TAG = "${version}-${env.VALIDATION_PROFILE}"
                    env.CI_IMAGE_TAG = "ci-${env.BUILD_NUMBER}-${env.VALIDATION_PROFILE}"
                }
            }
        }
        stage('Check out package sources') {
            steps {
                script {
                    dir('.ci-sources/msi') {
                        deleteDir()
                        env.MSI_RESOLVED_COMMIT = sh(
                            script: 'python3 "$WORKSPACE/scripts/checkout_msi.py"',
                            returnStdout: true
                        ).trim()
                    }

                }
            }
        }
        stage('Build MSI wheel') {
            steps {
                sh '''
                    set -eu
                    rm -rf .ci-package-build
                    python3 -m venv .ci-package-build
                    .ci-package-build/bin/python -m pip install 'build==1.2.2.post1'
                    .ci-package-build/bin/python scripts/build_validation_sources.py
                    python3 scripts/prepare_validation.py --wheels .ci-wheels --profile "$VALIDATION_PROFILE"
                '''
                archiveArtifacts artifacts: '.ci-wheels/*.whl,.ci-wheels/provenance.json', fingerprint: true
            }
        }
        stage('Build images') {
            steps {
                script {
                    sh '''
                        set +x
                        set -eu
                        export UV_INDEX_SYNTHEMA_USERNAME="$SYNTHEMA_PYPI_USERNAME"
                        export UV_INDEX_SYNTHEMA_PASSWORD="$SYNTHEMA_PYPI_PASSWORD"
                        python3 scripts/images.py --mode build --tag "$CI_IMAGE_TAG" --validation-profile "$VALIDATION_PROFILE"
                    '''
                }
            }
        }
        stage('Unit tests') {
            steps { sh 'python3 scripts/images.py --mode test --tag "$CI_IMAGE_TAG"' }
        }
        stage('Offline validation workflow') {
            steps {
                sh '''
                    docker run --rm -e PYTHONPATH=/common:/app/src:/workflow/apps/fl_server/src \
                        -e MLFLOW_URL=http://localhost -e NODE_NAME=ICH -e RABBIT_HOST=localhost \
                        -e RABBIT_USERNAME=test -e RABBIT_PASSWORD=test -e DATA_CATALOGUE_URL=http://catalogue \
                        -e DATA_CATALOGUE_TOKEN=test -e FLWR_TELEMETRY_ENABLED=0 \
                        -v "$WORKSPACE:/workflow:ro" "synthema-fl-client:$CI_IMAGE_TAG" \
                        python -m pytest /workflow/e2e/offline -q --import-mode=importlib
                '''
            }
        }
        stage('Push images') {
            when { expression { env.FL_SOURCE_BRANCH == 'origin/dev' } }
            steps {
                withCredentials([usernamePassword(credentialsId: 'harbor-jenkins-creds', usernameVariable: 'REG_USER', passwordVariable: 'REG_PASS')]) {
                    sh '''
                        set -eu
                        printf '%s' "$REG_PASS" | docker login --username "$REG_USER" --password-stdin "$DOCKER_REG"
                        python3 scripts/images.py --mode tag --old-tag "$CI_IMAGE_TAG" --new-tag "$RELEASE_IMAGE_TAG"
                        python3 scripts/images.py --mode push --tag "$RELEASE_IMAGE_TAG" --registry "$DOCKER_REG$DOCKER_REPO"
                    '''
                }
            }
        }
    }
    post {
        always {
            script {
                if (env.CI_IMAGE_TAG) { sh 'python3 scripts/images.py --mode untag --tag "$CI_IMAGE_TAG"' }
            }
        }
    }
}
